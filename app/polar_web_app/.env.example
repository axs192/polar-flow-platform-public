# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Supabase auth (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Exercise data ---
# The single athlete's Polar user id (same value the whatsapp_adapter/
# exercise-insights service uses) -- DynamoDB exercise_data partition key.
POLAR_USER_ID=
# S3 bucket holding one JSON object per user: {user_id}/profile.json and
# {user_id}/conversation.json (see src/context_store.py).
CONTEXT_BUCKET=
# AWS credentials for the DynamoDB (exercise_data) + S3 (CONTEXT_BUCKET)
# access above. Locally, the polar-app-prod CLI profile's own credential
# resolution may already cover this (AWS_PROFILE=polar-app-prod); on the
# Raspberry Pi, use a dedicated least-privilege credential instead -- see
# docs/runbooks/raspberry-pi-web-app.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Rate limiting / logging (optional -- sane defaults if unset) ---
RATE_LIMIT_ASK=20/minute
LOG_LEVEL=INFO
